---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { publicImage } from '../../utils/publicImage.js';

const items = (await getCollection('ai')).sort((a, b) => a.data.order - b.data.order);
const imageCount = items.filter((i) => i.data.type === 'image').length;
const videoCount = items.filter((i) => i.data.type === 'video').length;
---
<BaseLayout title="AI Gallery" description="Generative AI gallery — ComfyUI workflows, LoRA-trained models, image-to-video pipelines.">
  <section class="mx-auto max-w-[1400px] px-6 sm:px-10 pt-20 sm:pt-32 pb-16">
    <p class="label mb-6">Gallery · 02</p>
    <h1 class="display-xl font-display">
      Generative <span class="it">AI</span>.
    </h1>
    <p class="lead mt-8 max-w-2xl">
      A working gallery of AI-generated work, tagged with the exact model and parameters used. Mostly ComfyUI workflows — text-to-image with the <em>illustratious</em> checkpoint, plus a couple of Wan2.2 image-to-video pieces.
    </p>
    <div class="mt-8 flex flex-wrap items-baseline gap-6">
      <p class="idx">{items.length} total</p>
      <p class="idx">{imageCount} stills</p>
      <p class="idx">{videoCount} motion</p>
      <p class="idx">2025</p>
    </div>
  </section>

  <!-- Filter -->
  <section class="mx-auto max-w-[1400px] px-6 sm:px-10">
    <div class="border-y border-[color:var(--color-border)] py-4 flex flex-wrap gap-2 items-center">
      <span class="label mr-2">Type</span>
      <button data-ai-filter="all" class="ai-chip is-active">All</button>
      <button data-ai-filter="image" class="ai-chip">Image</button>
      <button data-ai-filter="video" class="ai-chip">Video</button>
    </div>
  </section>

  <!-- Gallery grid: 2-col for editorial feel -->
  <section class="mx-auto max-w-[1400px] px-6 sm:px-10 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {items.map((item, i) => {
        const img = publicImage(item.data.cover);
        return (
          <figure
            data-ai-item
            data-type={item.data.type}
            class:list={[
              'group relative bg-[color:var(--color-surface)] overflow-hidden',
              i % 5 === 0 ? 'sm:col-span-2' : '',
            ]}
          >
            <button
              type="button"
              class="block w-full text-left"
              data-lightbox-src={item.data.cover}
              data-lightbox-type={item.data.type}
              data-lightbox-caption={`${item.data.title} — ${item.data.model}, ${item.data.steps} steps, CFG ${item.data.cfg}`}
              aria-label={`Open ${item.data.title}`}
            >
              <div class:list={[
                'relative overflow-hidden bg-[color:var(--color-surface-2)]',
                i % 5 === 0 ? 'aspect-[21/9]' : 'aspect-[4/3]',
              ]}>
                {item.data.type === 'video' ? (
                  <video
                    src={item.data.cover}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    class="w-full h-full object-cover"
                  ></video>
                ) : img ? (
                  <Image
                    src={img}
                    alt={item.data.title}
                    loading={i < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                    widths={[320, 480, 640, 960, 1280]}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    format="webp"
                    quality={80}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-[color:var(--color-ink-faint)] label">
                    image missing
                  </div>
                )}
                {item.data.type === 'video' && (
                  <span class="absolute top-4 right-4 label bg-[color:var(--color-bg)]/80 backdrop-blur px-2 py-1 rounded">
                    ▶ motion
                  </span>
                )}
              </div>
            </button>

            <figcaption class="p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display text-xl group-hover:text-[color:var(--color-accent)] transition-colors">
                  {item.data.title}
                </h3>
                <span class="idx text-[10px]">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-[color:var(--color-ink-faint)] font-mono">
                <span>{item.data.webui}</span>
                <span>· {item.data.model}</span>
                {item.data.steps != null && <span>· {item.data.steps} steps</span>}
                {item.data.cfg != null && <span>· CFG {item.data.cfg}</span>}
              </div>
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .ai-chip {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: 0.7rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-ink-mute);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .ai-chip:hover { color: var(--color-ink); border-color: var(--color-border-strong); }
  .ai-chip.is-active {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.ai-chip');
  const items = document.querySelectorAll<HTMLElement>('[data-ai-item]');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      const filter = chip.dataset.aiFilter!;
      items.forEach((item) => {
        const show = filter === 'all' || item.dataset.type === filter;
        item.style.display = show ? '' : 'none';
      });
    });
  });
</script>
