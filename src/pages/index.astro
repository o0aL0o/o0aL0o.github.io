---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { publicImage } from '../utils/publicImage.js';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const allTags = Array.from(new Set(projects.flatMap((p) => p.data.tags))).sort();
const projectCount = projects.length;
const digital = await getCollection('digital');
const ai = await getCollection('ai');
const galleryCount = digital.length + ai.length;
---
<BaseLayout
  title="Adrian Law"
  description="Portfolio of Adrian Law (aL) — artist and developer working across game design, digital illustration, and generative AI. Based in Hong Kong."
>
  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class="relative">
    <div class="mx-auto max-w-[1400px] px-6 sm:px-10 pt-20 sm:pt-32 pb-24">
      <!-- Top eyebrow -->
      <div class="flex items-center gap-3 mb-10">
        <span class="label">Portfolio</span>
        <span class="h-px w-12 bg-[color:var(--color-border-strong)]"></span>
        <span class="label">2022 — 2025</span>
      </div>

      <!-- Display headline -->
      <h1 class="display-xl font-display">
        <span class="block">Artist</span>
        <span class="block">
          <span class="it">&amp;</span> developer
        </span>
        <span class="block text-[color:var(--color-ink-mute)]">
          building
          <span class="it"> worlds</span>,
        </span>
        <span class="block text-[color:var(--color-ink-mute)]">
          frame by frame.
        </span>
      </h1>

      <!-- Sub-statement -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-12 gap-10">
        <p class="md:col-span-5 md:col-start-7 lead">
          I'm <span class="text-[color:var(--color-ink)]">Adrian Law</span> (aL) — a Hong Kong–based designer working at the seam of games, illustration, and generative AI. I make things that look good, play well, and ship on time.
        </p>
      </div>

      <!-- Stat strip -->
      <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-10 border-t border-[color:var(--color-border)] pt-10">
        <div>
          <p class="display-md font-display">{projectCount}<span class="it">.</span></p>
          <p class="label mt-2">Projects shipped</p>
        </div>
        <div>
          <p class="display-md font-display">{galleryCount}<span class="it">.</span></p>
          <p class="label mt-2">Pieces in gallery</p>
        </div>
        <div>
          <p class="display-md font-display">3<span class="it">.</span></p>
          <p class="label mt-2">Engines in rotation</p>
        </div>
        <div>
          <p class="display-md font-display">HKG<span class="it">.</span></p>
          <p class="label mt-2">Based in Hong Kong</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FEATURED WORK
       ============================================================ -->
  <section class="border-t border-[color:var(--color-border)]">
    <div class="mx-auto max-w-[1400px] px-6 sm:px-10 py-24">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
        <div>
          <p class="label mb-3">Selected work</p>
          <h2 class="display-lg font-display">Featured <span class="it">projects</span></h2>
        </div>
        <a href="/work/" class="link">View all work <span aria-hidden="true">→</span></a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-[color:var(--color-border)]">
        {featured.map((p, i) => {
          const cover = publicImage(p.data.cover);
          return (
          <a
            href={`/work/${p.id.replace(/\.mdx?$/, '')}/`}
            class:list={[
              'group block bg-[color:var(--color-bg)] p-8 transition-colors hover:bg-[color:var(--color-surface)]',
              i === 0 && 'md:col-span-2',
            ]}
          >
            <div class="aspect-[16/9] overflow-hidden mb-6 bg-[color:var(--color-surface)]">
              {cover ? (
                <Image
                  src={cover}
                  alt={p.data.coverAlt || p.data.title}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  widths={[320, 480, 640, 960, 1280, 1600]}
                  sizes={i === 0 ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 33vw, 100vw'}
                  format="webp"
                  quality={82}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-[color:var(--color-ink-faint)] label">image missing</div>
              )}
            </div>
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <h3 class="display-sm font-display group-hover:text-[color:var(--color-accent)] transition-colors">
                {p.data.title}
              </h3>
              <span class="idx">{String(p.data.order).padStart(2, '0')} / {p.data.year}</span>
            </div>
            <p class="mt-2 text-[color:var(--color-ink-mute)] text-sm max-w-prose">
              {p.data.summary}
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {p.data.tags.slice(0, 4).map((t) => (
                <span class="label">{t}</span>
              ))}
            </div>
          </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============================================================
       CAPABILITIES
       ============================================================ -->
  <section class="border-t border-[color:var(--color-border)]">
    <div class="mx-auto max-w-[1400px] px-6 sm:px-10 py-24">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
        <div class="md:col-span-4">
          <p class="label mb-3">What I do</p>
          <h2 class="display-md font-display">
            A small set of <span class="it">tools</span>, used widely.
          </h2>
        </div>
        <div class="md:col-span-7 md:col-start-6 grid grid-cols-1 sm:grid-cols-2 gap-8">
          {[
            { n: '01', t: 'Game Design', d: 'Unity, Unreal Engine 5, and pure-paper design. I do systems, levels, and the kind of UI that doesn’t get in the way.' },
            { n: '02', t: 'Illustration', d: 'Clip Studio Paint for digital illustration, character work, and concept art.' },
            { n: '03', t: 'Generative AI', d: 'ComfyUI workflows, LoRA training, and image-to-video pipelines — used as a real tool, not a gimmick.' },
            { n: '04', t: 'UI / UX', d: 'Figma prototypes, design systems, and feature specs for mobile and web.' },
          ].map((c) => (
            <div class="border-t border-[color:var(--color-border)] pt-6">
              <div class="flex items-baseline justify-between">
                <p class="font-display text-2xl">{c.t}</p>
                <span class="idx">{c.n}</span>
              </div>
              <p class="mt-3 text-sm text-[color:var(--color-ink-mute)] leading-relaxed">{c.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CONTACT CTA
       ============================================================ -->
  <section class="border-t border-[color:var(--color-border)]">
    <div class="mx-auto max-w-[1400px] px-6 sm:px-10 py-32">
      <p class="label mb-6">Get in touch</p>
      <a href="/contact/" class="block group">
        <h2 class="display-xl font-display leading-[0.95]">
          Have an idea? <br />
          <span class="it group-hover:text-[color:var(--color-accent)] transition-colors">Let's build it.</span>
        </h2>
      </a>
      <div class="mt-12 flex flex-wrap gap-6">
        <a href="mailto:adrianlaw1127@gmail.com" class="link">adrianlaw1127@gmail.com <span aria-hidden="true">→</span></a>
        <a href="https://github.com/o0aL0o" class="link" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://x.com/aL_1127a" class="link" target="_blank" rel="noopener noreferrer">X / Twitter <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
